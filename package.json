{
  "name": "family-finance",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Aplikasi manajemen keuangan keluarga (Firebase + Vercel)",
  "scripts": {
    "build": "node scripts/build-config.mjs && node scripts/copy-dist.mjs",
    "config:local": "node --env-file=.env scripts/build-config.mjs",
    "start": "npx serve . -l 3000",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-imports.mjs",
    "test:integration": "node --import ./tests/register.mjs --test tests/integration/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "firebase-admin": "12.7.0"
  }
}
