# Salin menjadi .env untuk pengembangan lokal, lalu isi dari Firebase Console
# (Project settings > General > Your apps > Web app > Config).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Opsional: notifikasi push (lihat README). Kunci VAPID publik dari Firebase Console >
# Project settings > Cloud Messaging > Web Push certificates > Generate key pair.
FIREBASE_VAPID_KEY=
# FIREBASE_SERVICE_ACCOUNT hanya diisi di Vercel (Environment Variables), JANGAN pernah di berkas ini
# dan JANGAN di-commit. Isinya JSON kunci akun layanan Firebase.
